<?xml version="1.0" encoding="utf-8"?>
<!-- 河医大助手 · 今日课程小组件底 · NOVA「万象舱」深舱。
     桌面没有 App 的深浅上下文，所以只出一套中性深舱：深紫玻璃 + 青色描边，
     任何桌面背景上都读得清。纯色 + 线性渐变，不用实时模糊（低配机掉帧）。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#1D1538"
        android:endColor="#100B22"
        android:type="linear" />
    <stroke android:width="1.5dp" android:color="#9E8CFF" />
    <corners android:radius="12dp" />
    <padding android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp" />
</shape>
