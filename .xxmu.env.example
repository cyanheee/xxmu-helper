# xxmu-app 环境变量模板
# 用法：复制成 .xxmu.env 并填值（该文件已在 .gitignore 里，不会入库）
#       然后用 tools/run_sync.ps1 或 tools/sync_all.py 读取

# ---- 青果教务账号（仅在 session 过期需要重新登录时用到）----
# 注意：青果登录有图形验证码，无人值守跑不通；
#       这个账号只在你想让脚本自动尝试登录时才需要填。
XXMU_USER=20261440105
XXMU_PWD=

# ---- 学期参数 ----
# 秋季学期 xq=0，春季学期 xq=1
XXMU_XN=2026
XXMU_XQ=0
XXMU_TERM=2026-2027-1

# ---- 学习通 cookie 库（sqlite，只读）----
# Windows 用 adb pull 下来的本地副本：
XXMU_COOKIE_DB=D:\dsh\DSH Desktop\xxmu-app\data\cx_cookies.db
# 手机 Termux 上的原始路径：
# XXMU_COOKIE_DB=/sdcard/Download/DSH-Go/cx_cookies.db

# ---- 是否把 homework.json 推到手机外部目录 ----
# PC 上默认 0（不推）；想 adb 推或者手动拷就保持 0
XXMU_PUSH=0
# XXMU_PUSH_DIR=/sdcard/Android/data/com.xxmu.helper/files

# ---- node 路径（PATH 里没有 node 时才需要）----
# XXMU_NODE=C:\Program Files\nodejs\node.exe
